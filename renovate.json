{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCI images in NixOS service modules",
      "managerFilePatterns": [
        "/^services\\/.*\\.nix$/"
      ],
      "matchStrings": [
        "(?<indentation>[ \\t]*)image\\s*=\\s*\"(?<depName>[^\"@\\s]+):(?<currentValue>[^\"@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\";"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "{{{indentation}}}image = \"{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\";"
    }
  ],
  "timezone": "America/Indiana/Indianapolis",
  "packageRules": [
    {
      "description": "Update NixOS flake inputs weekly",
      "matchManagers": [
        "nix"
      ],
      "schedule": [
        "* 0-5 * * 4"
      ],
      "automerge": false
    },
    {
      "description": "Update OCI container images weekly",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "schedule": [
        "* 0-5 * * 4"
      ],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Keep Beszel hub and agent image updates together",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "services/service_beszel.nix",
        "services/service_beszel-agent-intel.nix"
      ],
      "groupName": "Beszel container images"
    },
    {
      "description": "Group non-major Home Assistant image updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "services/service_home-assistant.nix",
        "services/service_home-assistant-matter.nix"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "Home Assistant container images"
    },
    {
      "description": "Group non-major media automation image updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "services/service_cleanuparr.nix",
        "services/service_nzbget.nix",
        "services/service_profilarr.nix",
        "services/service_prowlarr.nix",
        "services/service_radarr.nix",
        "services/service_sonarr.nix"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "Media automation container images"
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
