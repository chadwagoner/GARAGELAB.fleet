{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "timezone": "America/Indiana/Indianapolis",
  "packageRules": [
    {
      "description": "Update NixOS flake inputs weekly",
      "matchManagers": [
        "nix"
      ],
      "schedule": [
        "* 0-5 * * 6"
      ],
      "automerge": false
    }
  ]
}
