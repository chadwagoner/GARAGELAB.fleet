{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCI images in NixOS service modules",
      "managerFilePatterns": [
        "/^services\\/.*\\.nix$/"
      ],
      "matchStrings": [
        "(?<indentation>[ \\t]*)image\\s*=\\s*\"(?<depName>[^\"@\\s]+):(?<currentValue>[^\"@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\";"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "{{{indentation}}}image = \"{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\";"
    }
  ],
  "timezone": "America/Indiana/Indianapolis",
  "packageRules": [
    {
      "description": "Skip releases whose final version component is zero, including tags with suffixes",
      "matchPackageNames": [
        "*"
      ],
      "allowedVersions": "!/\\.0(?:[-+]|$)/"
    },
    {
      "description": "Update NixOS flake inputs weekly",
      "matchManagers": [
        "nix"
      ],
      "schedule": [
        "* 0-5 * * 4"
      ],
      "automerge": false
    },
    {
      "description": "Update OCI container images weekly",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "schedule": [
        "* 0-5 * * 4"
      ],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "pinDigests": true,
      "automerge": false,
      "groupName": "Container images",
      "separateMajorMinor": false
    },
    {
      "description": "Allow Pulsarr 0.x and 1.x release tags with a nonzero patch",
      "matchDepNames": [
        "docker.io/lakker/pulsarr"
      ],
      "allowedVersions": "/^v?[01]\\.\\d+\\.[1-9]\\d*$/"
    },
    {
      "description": "Manually update the private Fastmail meeting nudger image",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/chadwagoner/fastmail-meeting-nudger"
      ],
      "enabled": false
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
